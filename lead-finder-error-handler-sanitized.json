      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -384,
        272
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $json.execution || {};\nconst wf = $json.workflow || {};\nconst err = e.error || {};\n\nreturn {\n  json: {\n    time: new Date().toISOString(),\n    workflow: wf.name || '',\n    failed_node: e.lastNodeExecuted || (err.node && err.node.name) || '',\n    message: String(err.message || 'Unknown error').slice(0, 500),\n    execution_id: e.id || '',\n    execution_url: e.url || '',\n    mode: e.mode || ''\n  }\n};"
      },
      "id": "1a913e2e-d4a1-473e-8b67-e6e5a8ca5009",
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
