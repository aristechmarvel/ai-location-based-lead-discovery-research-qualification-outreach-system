        "sendTo": "REPLACE_WITH_YOUR_ALERT_EMAIL",
        "subject": "=n8n workflow failed: {{ $json.workflow }}",
        "emailType": "text",
        "message": "=Workflow: {{ $json.workflow }}\nFailed node: {{ $json.failed_node }}\nError: {{ $json.message }}\nMode: {{ $json.mode }}\nTime: {{ $json.time }}\n\nExecution: {{ $json.execution_url }}",
